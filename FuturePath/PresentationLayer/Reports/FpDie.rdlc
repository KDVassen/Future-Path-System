                      <TextRun>
                        <Value>8   ADVISORY DISCLAIMER</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>9.5pt</FontSize>
                          <Color>#13294B</Color>
                        </Style>
