                          <CellContents>
                            <Textbox Name="FacultyPieLegendItem">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>■</Value>
                                      <Style>
                                        <FontFamily>Segoe UI Symbol</FontFamily>
                                        <FontSize>11pt</FontSize>
                                        <Color>=Switch(Fields!OutcomeOrder.Value = 1, "#1F6B3A", Fields!OutcomeOrder.Value = 2, "#C8892B", Fields!OutcomeOrder.Value = 3, "#8A5D18", True, "#58606C")</Color>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>  </Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>8pt</FontSize>
                                        <Color>#1B1F24</Color>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>=Switch(Fields!OutcomeOrder.Value = 1, "✓", Fields!OutcomeOrder.Value = 2, "!", Fields!OutcomeOrder.Value = 3, "✗", True, "?")</Value>
                                      <Style>
                                        <FontFamily>Segoe UI Symbol</FontFamily>
                                        <FontSize>9pt</FontSize>
                                        <FontWeight>SemiBold</FontWeight>
                                        <Color>=Switch(Fields!OutcomeOrder.Value = 1, "#1F6B3A", Fields!OutcomeOrder.Value = 2, "#C8892B", Fields!OutcomeOrder.Value = 3, "#8A5D18", True, "#58606C")</Color>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value> </Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>8pt</FontSize>
                                        <Color>#1B1F24</Color>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
