              <Textbox Name="GapTotalsNote">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>="A subject gap is a required subject not taken at all; a mark gap is a subject taken but below the stored minimum. A session can appear in both, against several subjects, and can be offered several funding categories, so the totals in sections 5 to 7 deliberately add up to more than the " &amp; First(Fields!SessionsInScope.Value, "ReportHeader") &amp; " sessions in scope. Gaps are calculated from the stored requirements when the report is generated."</Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8.5pt</FontSize>
                          <Color>#1B1F24</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <rd:DefaultName>GapTotalsNote</rd:DefaultName>
                <Top>7.85cm</Top>
                <Left>0cm</Left>
                <Height>0.85cm</Height>
                <Width>26.7cm</Width>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <VerticalAlign>Top</VerticalAlign>
                  <PaddingLeft>0pt</PaddingLeft>
                  <PaddingRight>2pt</PaddingRight>
                  <PaddingTop>2pt</PaddingTop>
                  <PaddingBottom>1pt</PaddingBottom>
                </Style>
              </Textbox>
              <Textbox Name="SampleDataNote">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Programme requirements and funding options are locally stored sample data. Verify them against the official university or funder source before advising a learner.</Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#58606C</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <rd:DefaultName>SampleDataNote</rd:DefaultName>
                <Top>8.75cm</Top>
                <Left>0cm</Left>
                <Height>0.5cm</Height>
                <Width>26.7cm</Width>
                <Style>
