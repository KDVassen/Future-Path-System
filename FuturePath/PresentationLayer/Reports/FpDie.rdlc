              <Textbox Name="Section2Heading">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>2   ADVISORY OUTCOMES ACROSS THE PERIOD</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
