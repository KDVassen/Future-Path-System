              </Textbox>
              <Textbox Name="Disclaimer">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>="This report aggregates the advisory sessions completed between " &amp; Format(First(Fields!PeriodStart.Value, "ReportHeader"), "d MMMM yyyy") &amp; " and " &amp; Format(First(Fields!PeriodEnd.Value, "ReportHeader"), "d MMMM yyyy") &amp; ". Advisory outcomes are preliminary, rule-based guidance produced by the Future Path rule engine from learner-captured subjects, marks and interest responses. They are not admission decisions and do not reflect any application made to an institution. Grade 11 marks are projected and will change. " &amp; IIf(First(Fields!IncludeInactive.Value, "ReportHeader"), "Deactivated qualifications and funding options are included at the user's request.", "Deactivated qualifications and funding options are excluded, so counts may not match a report generated on an earlier date.") &amp; " The report holds no learner names or profile data and is for Career Advisors and System Administrators only."</Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8.5pt</FontSize>
                          <Color>#1B1F24</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <rd:DefaultName>Disclaimer</rd:DefaultName>
                <Top>10.2cm</Top>
                <Left>0cm</Left>
                <Height>1.3cm</Height>
                <Width>26.7cm</Width>
