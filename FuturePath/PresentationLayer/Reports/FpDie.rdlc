  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Rectangle Name="Page1">
            <ReportItems>
              <Rectangle Name="MastheadDetailBand">
                <ReportItems>
                  <Textbox Name="MastheadSubtitle">
                    <CanGrow>true</CanGrow>
                    <KeepTogether>true</KeepTogether>
                    <Paragraphs>
                      <Paragraph>
                        <TextRuns>
                          <TextRun>
                            <Value>Advisory activity across all learners   ·   aggregated counts only, no learner names or profile data</Value>
                            <Style>
                              <FontFamily>Segoe UI</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#B9C7DC</Color>
                            </Style>
                          </TextRun>
                        </TextRuns>
                        <Style>
                          <TextAlign>Left</TextAlign>
                        </Style>
                      </Paragraph>
                    </Paragraphs>
                    <rd:DefaultName>MastheadSubtitle</rd:DefaultName>
                    <Top>0cm</Top>
                    <Left>0.4cm</Left>
                    <Height>0.5cm</Height>
                    <Width>25.9cm</Width>
                    <Style>
                      <Border>
                        <Style>None</Style>
                      </Border>
                      <VerticalAlign>Top</VerticalAlign>
                      <PaddingLeft>0pt</PaddingLeft>
                      <PaddingRight>0pt</PaddingRight>
                      <PaddingTop>0pt</PaddingTop>
                      <PaddingBottom>0pt</PaddingBottom>
                    </Style>
                  </Textbox>
                  <Line Name="MastheadRule">
                    <Top>0.56cm</Top>
                    <Left>0.4cm</Left>
                    <Height>0cm</Height>
                    <Width>25.9cm</Width>
                    <Style>
                      <Border>
                        <Color>#3A5480</Color>
                        <Style>Solid</Style>
                        <Width>0.75pt</Width>
                      </Border>
                    </Style>
                  </Line>
                  <Textbox Name="MastheadDetails">
                    <CanGrow>true</CanGrow>
                    <KeepTogether>true</KeepTogether>
                    <Paragraphs>
                      <Paragraph>
                        <TextRuns>
                          <TextRun>
                            <Value>Period  </Value>
                            <Style>
                              <FontFamily>Segoe UI</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#B9C7DC</Color>
                            </Style>
                          </TextRun>
                          <TextRun>
                            <Value>=Format(First(Fields!PeriodStart.Value, "ReportHeader"), IIf(Year(First(Fields!PeriodStart.Value, "ReportHeader")) = Year(First(Fields!PeriodEnd.Value, "ReportHeader")), "d MMMM", "d MMMM yyyy")) &amp; " – " &amp; Format(First(Fields!PeriodEnd.Value, "ReportHeader"), "d MMMM yyyy")</Value>
                            <Style>
                              <FontFamily>Segoe UI Semibold</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#FFFFFF</Color>
                            </Style>
                          </TextRun>
                          <TextRun>
                            <Value>="   ·   "</Value>
                            <Style>
                              <FontFamily>Segoe UI</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#B9C7DC</Color>
                            </Style>
                          </TextRun>
                          <TextRun>
                            <Value>Generated by  </Value>
                            <Style>
                              <FontFamily>Segoe UI</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#B9C7DC</Color>
                            </Style>
                          </TextRun>
                          <TextRun>
                            <Value>=IIf(IsNothing(First(Fields!GeneratedByName.Value, "ReportHeader")), "–", First(Fields!GeneratedByName.Value, "ReportHeader"))</Value>
                            <Style>
                              <FontFamily>Segoe UI Semibold</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#FFFFFF</Color>
                            </Style>
                          </TextRun>
                          <TextRun>
                            <Value>="   ·   "</Value>
                            <Style>
                              <FontFamily>Segoe UI</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#B9C7DC</Color>
                            </Style>
                          </TextRun>
                          <TextRun>
                            <Value>Generated  </Value>
                            <Style>
                              <FontFamily>Segoe UI</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#B9C7DC</Color>
                            </Style>
                          </TextRun>
                          <TextRun>
                            <Value>=Format(First(Fields!GeneratedAt.Value, "ReportHeader"), "d MMMM yyyy, HH:mm")</Value>
                            <Style>
                              <FontFamily>Segoe UI Semibold</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#FFFFFF</Color>
                            </Style>
                          </TextRun>
                          <TextRun>
                            <Value>="   ·   "</Value>
                            <Style>
                              <FontFamily>Segoe UI</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#B9C7DC</Color>
                            </Style>
                          </TextRun>
                          <TextRun>
                            <Value>Sessions in scope  </Value>
                            <Style>
                              <FontFamily>Segoe UI</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#B9C7DC</Color>
                            </Style>
                          </TextRun>
                          <TextRun>
                            <Value>=First(Fields!SessionsInScope.Value, "ReportHeader")</Value>
                            <Style>
                              <FontFamily>Consolas</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#FFFFFF</Color>
                            </Style>
                          </TextRun>
                          <TextRun>
                            <Value>="   ·   "</Value>
                            <Style>
                              <FontFamily>Segoe UI</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#B9C7DC</Color>
                            </Style>
                          </TextRun>
                          <TextRun>
                            <Value>Report  </Value>
                            <Style>
                              <FontFamily>Segoe UI</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#B9C7DC</Color>
                            </Style>
                          </TextRun>
                          <TextRun>
                            <Value>=First(Fields!ReportCode.Value, "ReportHeader")</Value>
                            <Style>
                              <FontFamily>Segoe UI Semibold</FontFamily>
                              <FontSize>8.5pt</FontSize>
                              <Color>#FFFFFF</Color>
                            </Style>
                          </TextRun>
                        </TextRuns>
                        <Style>
                          <TextAlign>Left</TextAlign>
                        </Style>
                      </Paragraph>
                    </Paragraphs>
                    <rd:DefaultName>MastheadDetails</rd:DefaultName>
                    <Top>0.68cm</Top>
                    <Left>0.4cm</Left>
                    <Height>0.55cm</Height>
                    <Width>25.9cm</Width>
                    <Style>
                      <Border>
                        <Style>None</Style>
                      </Border>
                      <VerticalAlign>Middle</VerticalAlign>
                      <PaddingLeft>0pt</PaddingLeft>
                      <PaddingRight>0pt</PaddingRight>
                      <PaddingTop>0pt</PaddingTop>
                      <PaddingBottom>0pt</PaddingBottom>
                    </Style>
                  </Textbox>
                </ReportItems>
                <KeepTogether>true</KeepTogether>
                <Top>0cm</Top>
                <Left>0cm</Left>
                <Height>1.45cm</Height>
                <Width>26.7cm</Width>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <BackgroundColor>#13294B</BackgroundColor>
                </Style>
              </Rectangle>
              <Textbox Name="ParameterLine">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Completed sessions from  </Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8.5pt</FontSize>
                          <Color>#58606C</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=Format(First(Fields!PeriodStart.Value, "ReportHeader"), "dd/MM/yyyy")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>8.5pt</FontSize>
                          <Color>#1B1F24</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>  to  </Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8.5pt</FontSize>
                          <Color>#58606C</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=Format(First(Fields!PeriodEnd.Value, "ReportHeader"), "dd/MM/yyyy")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>8.5pt</FontSize>
                          <Color>#1B1F24</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>="   ·   Faculty  "</Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8.5pt</FontSize>
                          <Color>#58606C</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=First(Fields!FacultyFilter.Value, "ReportHeader")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>8.5pt</FontSize>
                          <Color>#1B1F24</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>="   ·   Grade  "</Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8.5pt</FontSize>
                          <Color>#58606C</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=First(Fields!GradeFilter.Value, "ReportHeader")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>8.5pt</FontSize>
                          <Color>#1B1F24</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>="   ·   Outcome  "</Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8.5pt</FontSize>
                          <Color>#58606C</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=First(Fields!OutcomeFilter.Value, "ReportHeader")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>8.5pt</FontSize>
                          <Color>#1B1F24</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>="   ·   Inactive qualifications and funding  "</Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8.5pt</FontSize>
                          <Color>#58606C</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=IIf(First(Fields!IncludeInactive.Value, "ReportHeader"), "Included", "Excluded")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
