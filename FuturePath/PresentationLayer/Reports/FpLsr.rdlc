  <Code>
' FP-LSR display helpers. They only turn values the Business Logic Layer has already decided
' (OutcomeCode, ResultCode, Shortfall) into a marker character, words and a colour.
' No eligibility rule, threshold or calculation lives in this report.

Private Function Clean(ByVal value As Object) As String
    If value Is Nothing OrElse IsDBNull(value) Then Return ""
    Return UCase(Trim(CStr(value)))
End Function

' S strong, P possible, N not currently eligible, I more information needed
' (read the same way as the UI 6 and UI 6.1a screens).
Public Function OutcomeKind(ByVal outcomeCode As Object) As String
    Dim c As String = Clean(outcomeCode)
    If c.StartsWith("STRONG") OrElse c = "SM" Then Return "S"
    If c.StartsWith("POSSIBLE") OrElse c = "PM" Then Return "P"
    If c.StartsWith("NOT") OrElse c = "NCE" Then Return "N"
    Return "I"
End Function

Public Function OutcomeMarker(ByVal outcomeCode As Object) As String
    Select Case OutcomeKind(outcomeCode)
        Case "S"
            Return ChrW(&amp;H2713)
        Case "P"
            Return "!"
        Case "N"
            Return ChrW(&amp;H2717)
        Case Else
            Return "?"
    End Select
End Function

Public Function OutcomeWords(ByVal outcomeCode As Object) As String
    Select Case OutcomeKind(outcomeCode)
        Case "S"
            Return "Strong match"
        Case "P"
            Return "Possible match"
        Case "N"
            Return "Not currently eligible"
        Case Else
            Return "More information needed"
    End Select
End Function

' Green for a strong match, amber for a possible match or not currently eligible, muted grey
' when more information is needed. Never red: red is kept for invalid input on the screens.
Public Function OutcomeColour(ByVal outcomeCode As Object) As String
    Select Case OutcomeKind(outcomeCode)
        Case "S"
            Return "#1F6B3A"
        Case "P", "N"
            Return "#8A5D18"
        Case Else
            Return "#58606C"
    End Select
End Function

' ResultCode is Met, Gap or NotAssessed.
Public Function ResultMarker(ByVal resultCode As Object) As String
    Select Case Clean(resultCode)
        Case "MET"
            Return ChrW(&amp;H2713)
        Case "GAP"
            Return "!"
        Case Else
            Return ChrW(&amp;H2013)
    End Select
End Function

Public Function ResultColour(ByVal resultCode As Object) As String
    Select Case Clean(resultCode)
        Case "MET"
            Return "#1F6B3A"
        Case "GAP"
            Return "#8A5D18"
        Case Else
            Return "#58606C"
    End Select
End Function

' Bar colour in Chart 1: the lighter amber reads better as a fill than the text amber.
Public Function ResultBarColour(ByVal resultCode As Object) As String
    Select Case Clean(resultCode)
        Case "MET"
            Return "#1F6B3A"
        Case "GAP"
            Return "#C8892B"
        Case Else
            Return "#58606C"
    End Select
End Function

' The words after the marker. The shortfall is the figure the BLL stored; it is only formatted here.
Public Function ResultWords(ByVal resultCode As Object, ByVal mark As Object, ByVal shortfall As Object) As String
    Select Case Clean(resultCode)
        Case "MET"
            Return "Met"
        Case "GAP"
            If mark Is Nothing OrElse IsDBNull(mark) Then Return "Not taken"
            If shortfall Is Nothing OrElse IsDBNull(shortfall) Then Return "Below the minimum"
            If CDec(shortfall) = 1D Then Return "1 point short"
            Return Format(CDec(shortfall), "0.#") &amp; " points short"
        Case Else
            Return "Not assessed"
    End Select
End Function

' "First Last"; either part may be blank on UI 2.
Public Function LearnerName(ByVal firstName As Object, ByVal lastName As Object) As String
    Dim f As String = ""
    Dim l As String = ""
    If Not (firstName Is Nothing OrElse IsDBNull(firstName)) Then f = Trim(CStr(firstName))
    If Not (lastName Is Nothing OrElse IsDBNull(lastName)) Then l = Trim(CStr(lastName))
    Dim n As String = Trim(f &amp; " " &amp; l)
    If n = "" Then Return "Name not given"
    Return n
End Function

' A figure, or an en dash when there is none.
Public Function Figure(ByVal value As Object) As String
    If value Is Nothing OrElse IsDBNull(value) Then Return ChrW(&amp;H2013)
    Return Format(CDec(value), "0.#")
End Function
</Code>
