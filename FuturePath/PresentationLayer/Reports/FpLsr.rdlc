            </Style>
          </Textbox>
          <Chart Name="chtInterestProfile">
            <ChartCategoryHierarchy>
              <ChartMembers>
                <ChartMember>
                  <Group Name="grpInterestCategory">
                    <GroupExpressions>
                      <GroupExpression>=Fields!CategoryName.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Sum(Fields!InterestPercent.Value)</Value>
                      <Direction>Descending</Direction>
                    </SortExpression>
                    <SortExpression>
                      <Value>=Fields!CategoryName.Value</Value>
