    </DataSet>
    <DataSet Name="FundingOptions">
      <Query>
        <DataSourceName>FpLsrData</DataSourceName>
        <CommandText>/* Local Query */</CommandText>
      </Query>
      <Fields>
        <Field Name="FundingName">
          <DataField>FundingName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FundingType">
          <DataField>FundingType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LinkedTo">
          <DataField>LinkedTo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EligibilityDescription">
          <DataField>EligibilityDescription</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RequiredDocuments">
          <DataField>RequiredDocuments</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
