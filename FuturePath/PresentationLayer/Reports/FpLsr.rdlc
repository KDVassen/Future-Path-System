  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <!-- Page 1: masthead band -->
          <Rectangle Name="rectMasthead">
            <ReportItems>
              <Textbox Name="txtReportTitle">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Learner Advisory Summary</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>17pt</FontSize>
                          <Color>White</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>    FUTURE PATH</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>7.5pt</FontSize>
                          <Color>#B9C6D8</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <Top>0.22cm</Top>
                <Left>0.6cm</Left>
                <Height>0.85cm</Height>
                <Width>12cm</Width>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <VerticalAlign>Bottom</VerticalAlign>
                  <PaddingLeft>0pt</PaddingLeft>
                  <PaddingRight>0pt</PaddingRight>
                  <PaddingTop>0pt</PaddingTop>
                  <PaddingBottom>0pt</PaddingBottom>
                </Style>
              </Textbox>
              <Textbox Name="txtReportId">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Report  </Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#B9C6D8</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=First(Fields!ReportCode.Value, "ReportHeader")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>11pt</FontSize>
                          <Color>White</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Right</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>0.4cm</Top>
                <Left>12.8cm</Left>
                <Height>0.6cm</Height>
                <Width>4.6cm</Width>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <VerticalAlign>Bottom</VerticalAlign>
                  <PaddingLeft>0pt</PaddingLeft>
                  <PaddingRight>0pt</PaddingRight>
                  <PaddingTop>0pt</PaddingTop>
                  <PaddingBottom>0pt</PaddingBottom>
                </Style>
              </Textbox>
              <Textbox Name="txtSystemName">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Future Path Student Advising System</Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8.5pt</FontSize>
                          <Color>#C9D3E0</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <Top>1.04cm</Top>
                <Left>0.6cm</Left>
                <Height>0.45cm</Height>
                <Width>12cm</Width>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>0pt</PaddingLeft>
                  <PaddingRight>0pt</PaddingRight>
                  <PaddingTop>0pt</PaddingTop>
                  <PaddingBottom>0pt</PaddingBottom>
                </Style>
              </Textbox>
              <Line Name="lnMastheadRule">
                <Top>1.56cm</Top>
                <Left>0.6cm</Left>
                <Height>0cm</Height>
                <Width>16.8cm</Width>
                <Style>
                  <Border>
                    <Color>#3A5276</Color>
                    <Style>Solid</Style>
                    <Width>0.75pt</Width>
                  </Border>
                </Style>
              </Line>
              <Textbox Name="txtMastheadDetails">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Learner </Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#B9C6D8</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=Code.LearnerName(First(Fields!FirstName.Value, "ReportHeader"), First(Fields!LastName.Value, "ReportHeader"))</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>White</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>    Session </Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#B9C6D8</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=First(Fields!SessionNumber.Value, "ReportHeader")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>White</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>    Session date </Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#B9C6D8</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=First(Fields!SessionDate.Value, "ReportHeader")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Format>d MMMM yyyy</Format>
                          <Color>White</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>    Generated </Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#B9C6D8</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=First(Fields!DateGenerated.Value, "ReportHeader")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Format>d MMMM yyyy, HH:mm</Format>
                          <Color>White</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <Top>1.64cm</Top>
                <Left>0.6cm</Left>
                <Height>0.5cm</Height>
                <Width>16.8cm</Width>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <VerticalAlign>Middle</VerticalAlign>
                  <PaddingLeft>0pt</PaddingLeft>
                  <PaddingRight>0pt</PaddingRight>
                  <PaddingTop>0pt</PaddingTop>
                  <PaddingBottom>0pt</PaddingBottom>
                </Style>
              </Textbox>
            </ReportItems>
            <KeepTogether>false</KeepTogether>
            <Top>0cm</Top>
            <Left>0cm</Left>
            <Height>2.35cm</Height>
            <Width>18cm</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <BackgroundColor>#13294B</BackgroundColor>
            </Style>
          </Rectangle>
          <!-- Identity line (no contact details) -->
          <Textbox Name="txtIdentityLine">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=First(Fields!GradeDescription.Value, "ReportHeader")</Value>
                    <Style>
                      <FontFamily>Segoe UI Semibold</FontFamily>
                      <FontSize>9pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>  ·  </Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>9pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!SchoolName.Value, "ReportHeader")</Value>
                    <Style>
                      <FontFamily>Segoe UI Semibold</FontFamily>
                      <FontSize>9pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>  ·  </Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>9pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!Province.Value, "ReportHeader")</Value>
                    <Style>
                      <FontFamily>Segoe UI Semibold</FontFamily>
                      <FontSize>9pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>  ·  </Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>9pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!SubjectCount.Value, "ReportHeader")</Value>
                    <Style>
                      <FontFamily>Segoe UI Semibold</FontFamily>
                      <FontSize>9pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> subjects captured</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>9pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>  ·  overall average </Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>9pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!OverallAverage.Value, "ReportHeader")</Value>
                    <Style>
                      <FontFamily>Segoe UI Semibold</FontFamily>
                      <FontSize>9pt</FontSize>
                      <Format>0.0'%'</Format>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=" (" &amp; LCase(First(Fields!MarkBasis.Value, "ReportHeader")) &amp; " marks)"</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>9pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>2.6cm</Top>
            <Left>0cm</Left>
            <Height>0.5cm</Height>
            <Width>18cm</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <PaddingLeft>0pt</PaddingLeft>
              <PaddingRight>0pt</PaddingRight>
              <PaddingTop>0pt</PaddingTop>
              <PaddingBottom>0pt</PaddingBottom>
            </Style>
          </Textbox>
          <!-- Outcome statement with its reason -->
          <Textbox Name="txtOutcomeHeadline">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Code.OutcomeMarker(First(Fields!OutcomeCode.Value, "ReportHeader"))</Value>
                    <Style>
                      <FontFamily>Segoe UI Symbol</FontFamily>
                      <FontSize>13pt</FontSize>
                      <FontWeight>SemiBold</FontWeight>
                      <Color>=Code.OutcomeColour(First(Fields!OutcomeCode.Value, "ReportHeader"))</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>  </Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>13pt</FontSize>
                      <Color>=Code.OutcomeColour(First(Fields!OutcomeCode.Value, "ReportHeader"))</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Code.OutcomeWords(First(Fields!OutcomeCode.Value, "ReportHeader")) &amp; " — " &amp; First(Fields!ProgrammeName.Value, "ReportHeader")</Value>
                    <Style>
                      <FontFamily>Segoe UI Semibold</FontFamily>
                      <FontSize>13pt</FontSize>
                      <Color>=Code.OutcomeColour(First(Fields!OutcomeCode.Value, "ReportHeader"))</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>="   ·  " &amp; First(Fields!FacultyName.Value, "ReportHeader")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>9pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>3.3cm</Top>
            <Left>0cm</Left>
            <Height>0.75cm</Height>
            <Width>18cm</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <VerticalAlign>Bottom</VerticalAlign>
              <PaddingLeft>0pt</PaddingLeft>
              <PaddingRight>0pt</PaddingRight>
              <PaddingTop>0pt</PaddingTop>
              <PaddingBottom>0pt</PaddingBottom>
            </Style>
          </Textbox>
          <Textbox Name="txtOutcomeReason">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=First(Fields!OutcomeReason.Value, "ReportHeader")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>9.5pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>4.05cm</Top>
            <Left>0cm</Left>
            <Height>0.5cm</Height>
            <Width>18cm</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <PaddingLeft>0pt</PaddingLeft>
              <PaddingRight>0pt</PaddingRight>
              <PaddingTop>1pt</PaddingTop>
              <PaddingBottom>0pt</PaddingBottom>
            </Style>
          </Textbox>
          <!-- Table 1: subjects and marks with the requirement check merged in (subjects by name) -->
          <Textbox Name="txtSubjectsHeading">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>SUBJECTS, MARKS AND THE REQUIREMENT CHECK</Value>
                    <Style>
                      <FontFamily>Segoe UI Semibold</FontFamily>
                      <FontSize>9.5pt</FontSize>
                      <Color>#13294B</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>   </Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!SubjectCount.Value, "ReportHeader") &amp; IIf(First(Fields!SubjectCount.Value, "ReportHeader") = 1, " subject", " subjects") &amp; "  ·  " &amp; First(Fields!RequirementsChecked.Value, "ReportHeader") &amp; " requirements checked"</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>4.85cm</Top>
            <Left>0cm</Left>
            <Height>0.55cm</Height>
            <Width>18cm</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <VerticalAlign>Bottom</VerticalAlign>
              <PaddingLeft>0pt</PaddingLeft>
              <PaddingRight>0pt</PaddingRight>
              <PaddingTop>0pt</PaddingTop>
              <PaddingBottom>1pt</PaddingBottom>
            </Style>
          </Textbox>
