          <!-- Chart 2: interest profile by category (score descending) -->
          <Textbox Name="txtInterestHeading">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>YOUR INTEREST PROFILE</Value>
                    <Style>
                      <FontFamily>Segoe UI Semibold</FontFamily>
                      <FontSize>9.5pt</FontSize>
                      <Color>#13294B</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>   </Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!QuestionsAnswered.Value, "ReportHeader") &amp; " questions answered  ·  " &amp; CountRows("InterestProfile") &amp; " categories scored"</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Color>#58606C</Color>
