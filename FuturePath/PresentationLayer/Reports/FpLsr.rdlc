                      <ChartDataLabel>
                        <Style>
                          <FontFamily>Segoe UI Symbol</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#1B1F24</Color>
                        </Style>
                        <Label>=Code.Figure(Sum(Fields!Mark.Value)) &amp; " / " &amp; Code.Figure(Sum(Fields!MinimumMark.Value)) &amp; "  " &amp; Code.ResultMarker(First(Fields!ResultCode.Value))</Label>
                        <Visible>true</Visible>
                        <Position>Right</Position>
                      </ChartDataLabel>
                      <Style>
                        <Color>=Code.ResultBarColour(First(Fields!ResultCode.Value))</Color>
                        <Border>
