                              <Style>Solid</Style>
                              <Width>1.25pt</Width>
                            </TopBorder>
                            <BottomBorder>
                              <Color>#8C949F</Color>
                              <Style>Solid</Style>
                              <Width>0.75pt</Width>
                            </BottomBorder>
                            <VerticalAlign>Bottom</VerticalAlign>
                            <PaddingLeft>3pt</PaddingLeft>
                            <PaddingRight>3pt</PaddingRight>
                            <PaddingTop>1.5pt</PaddingTop>
                            <PaddingBottom>1.5pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="hdrMark">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
