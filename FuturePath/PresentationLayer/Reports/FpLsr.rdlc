          <Chart Name="chtMarkComparison">
            <ChartCategoryHierarchy>
              <ChartMembers>
                <ChartMember>
                  <Group Name="grpMarkComparisonLabel">
                    <GroupExpressions>
                      <GroupExpression>=Fields!Label.Value</GroupExpression>
