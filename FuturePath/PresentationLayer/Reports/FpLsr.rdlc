<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>FP-LSR Learner Advisory Summary Report (spec 6.1). Two A4 portrait pages, one per completed advisory session. Rendered from the typed DataSet FpLsrData; no queries and no business rules.</Description>
  <Author>Future Path (INF2011S Team 14)</Author>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="FpLsrData">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local Connection */</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>6d3c2f0e-7a51-4c8e-9a43-5f1b0c2d9e71</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="ReportHeader">
      <Query>
        <DataSourceName>FpLsrData</DataSourceName>
        <CommandText>/* Local Query */</CommandText>
      </Query>
      <Fields>
        <Field Name="ReportCode">
          <DataField>ReportCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SessionNumber">
          <DataField>SessionNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SessionDate">
          <DataField>SessionDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DateGenerated">
          <DataField>DateGenerated</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="FirstName">
          <DataField>FirstName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastName">
          <DataField>LastName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GradeDescription">
          <DataField>GradeDescription</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MarkBasis">
          <DataField>MarkBasis</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SchoolName">
          <DataField>SchoolName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Province">
          <DataField>Province</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SubjectCount">
          <DataField>SubjectCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OverallAverage">
          <DataField>OverallAverage</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ProgrammeName">
          <DataField>ProgrammeName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FacultyName">
          <DataField>FacultyName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MinimumOverallAverage">
          <DataField>MinimumOverallAverage</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AverageResultCode">
          <DataField>AverageResultCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AverageShortfall">
          <DataField>AverageShortfall</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="RequirementsChecked">
          <DataField>RequirementsChecked</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="RequirementsMet">
          <DataField>RequirementsMet</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OutcomeCode">
          <DataField>OutcomeCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OutcomeReason">
          <DataField>OutcomeReason</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="QuestionsAnswered">
          <DataField>QuestionsAnswered</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OverallGuidance">
          <DataField>OverallGuidance</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IncludeAlternatives">
          <DataField>IncludeAlternatives</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="IncludeFunding">
          <DataField>IncludeFunding</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
      </Fields>
      <rd:DataSetInfo>
        <rd:DataSetName>FpLsrData</rd:DataSetName>
        <rd:SchemaPath>..\..\ApplicationLayer\Reports\FpLsrData.xsd</rd:SchemaPath>
        <rd:TableName>ReportHeader</rd:TableName>
        <rd:TableAdapterFillMethod />
        <rd:TableAdapterGetDataMethod />
        <rd:TableAdapterName />
      </rd:DataSetInfo>
    </DataSet>
    <DataSet Name="SubjectRequirements">
      <Query>
        <DataSourceName>FpLsrData</DataSourceName>
        <CommandText>/* Local Query */</CommandText>
      </Query>
      <Fields>
        <Field Name="SubjectName">
          <DataField>SubjectName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Mark">
          <DataField>Mark</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="RequirementType">
          <DataField>RequirementType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AdvisoryNote">
          <DataField>AdvisoryNote</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MinimumMark">
          <DataField>MinimumMark</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ResultCode">
          <DataField>ResultCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Shortfall">
          <DataField>Shortfall</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
      <rd:DataSetInfo>
        <rd:DataSetName>FpLsrData</rd:DataSetName>
        <rd:SchemaPath>..\..\ApplicationLayer\Reports\FpLsrData.xsd</rd:SchemaPath>
        <rd:TableName>SubjectRequirements</rd:TableName>
        <rd:TableAdapterFillMethod />
        <rd:TableAdapterGetDataMethod />
        <rd:TableAdapterName />
      </rd:DataSetInfo>
    </DataSet>
    <DataSet Name="MarkComparison">
      <Query>
        <DataSourceName>FpLsrData</DataSourceName>
        <CommandText>/* Local Query */</CommandText>
      </Query>
      <Fields>
        <Field Name="Label">
          <DataField>Label</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Mark">
          <DataField>Mark</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="MinimumMark">
          <DataField>MinimumMark</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ResultCode">
          <DataField>ResultCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IsOverallAverage">
          <DataField>IsOverallAverage</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
      </Fields>
      <rd:DataSetInfo>
        <rd:DataSetName>FpLsrData</rd:DataSetName>
        <rd:SchemaPath>..\..\ApplicationLayer\Reports\FpLsrData.xsd</rd:SchemaPath>
        <rd:TableName>MarkComparison</rd:TableName>
        <rd:TableAdapterFillMethod />
        <rd:TableAdapterGetDataMethod />
        <rd:TableAdapterName />
      </rd:DataSetInfo>
    </DataSet>
    <DataSet Name="InterestProfile">
      <Query>
        <DataSourceName>FpLsrData</DataSourceName>
        <CommandText>/* Local Query */</CommandText>
      </Query>
      <Fields>
        <Field Name="CategoryName">
          <DataField>CategoryName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InterestPercent">
          <DataField>InterestPercent</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
      <rd:DataSetInfo>
        <rd:DataSetName>FpLsrData</rd:DataSetName>
        <rd:SchemaPath>..\..\ApplicationLayer\Reports\FpLsrData.xsd</rd:SchemaPath>
        <rd:TableName>InterestProfile</rd:TableName>
        <rd:TableAdapterFillMethod />
        <rd:TableAdapterGetDataMethod />
        <rd:TableAdapterName />
      </rd:DataSetInfo>
    </DataSet>
    <DataSet Name="Alternatives">
      <Query>
        <DataSourceName>FpLsrData</DataSourceName>
        <CommandText>/* Local Query */</CommandText>
      </Query>
      <Fields>
        <Field Name="AlternativeRank">
          <DataField>AlternativeRank</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ProgrammeName">
          <DataField>ProgrammeName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FacultyName">
          <DataField>FacultyName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OverallScore">
          <DataField>OverallScore</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="OutcomeCode">
          <DataField>OutcomeCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OutcomeReason">
          <DataField>OutcomeReason</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <rd:DataSetInfo>
        <rd:DataSetName>FpLsrData</rd:DataSetName>
        <rd:SchemaPath>..\..\ApplicationLayer\Reports\FpLsrData.xsd</rd:SchemaPath>
        <rd:TableName>Alternatives</rd:TableName>
        <rd:TableAdapterFillMethod />
        <rd:TableAdapterGetDataMethod />
        <rd:TableAdapterName />
