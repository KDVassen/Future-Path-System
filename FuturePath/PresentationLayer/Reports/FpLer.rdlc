          <Chart Name="ReasonChart">
            <ChartCategoryHierarchy>
              <ChartMembers>
                <ChartMember>
                  <Group Name="ReasonChartCategory">
                    <GroupExpressions>
                      <GroupExpression>=Fields!ReasonCategory.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Sum(Fields!ReasonCount.Value)</Value>
                      <Direction>Descending</Direction>
                    </SortExpression>
                    <SortExpression>
                      <Value>=Fields!ReasonCategory.Value</Value>
                    </SortExpression>
                  </SortExpressions>
                  <Label>=Fields!ReasonCategory.Value</Label>
                </ChartMember>
              </ChartMembers>
            </ChartCategoryHierarchy>
            <ChartSeriesHierarchy>
              <ChartMembers>
                <ChartMember>
                  <Label>Reasons recorded</Label>
                </ChartMember>
              </ChartMembers>
            </ChartSeriesHierarchy>
            <ChartData>
              <ChartSeriesCollection>
                <ChartSeries Name="ReasonCountSeries">
                  <ChartDataPoints>
                    <ChartDataPoint>
                      <ChartDataPointValues>
                        <Y>=Sum(Fields!ReasonCount.Value)</Y>
                      </ChartDataPointValues>
                      <ChartDataLabel>
                        <Style>
                          <FontFamily>Consolas</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#1B1F24</Color>
                        </Style>
                        <UseValueAsLabel>true</UseValueAsLabel>
                        <Visible>true</Visible>
