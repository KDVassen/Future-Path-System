                                    <FontSize>8.5pt</FontSize>
                                    <Color>#13294B</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>="    " &amp; Count(Fields!SessionID.Value) &amp; IIf(Count(Fields!SessionID.Value) = 1, " exception", " exceptions") &amp; " · " &amp; Sum(Fields!NotEligibleCount.Value) &amp; " not currently eligible · " &amp; Sum(Fields!MoreInfoNeededCount.Value) &amp; " more information needed"</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>7.5pt</FontSize>
                                    <Color>#58606C</Color>
                                  </Style>
