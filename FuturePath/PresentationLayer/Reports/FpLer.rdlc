                      <FontSize>9pt</FontSize>
                      <Color>#13294B</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>="    " &amp; CInt(Sum(Fields!ReasonCount.Value, "ReasonSummary")) &amp; " reasons recorded across " &amp; First(Fields!ExceptionCount.Value, "ReportHeader") &amp; " exceptions"</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
