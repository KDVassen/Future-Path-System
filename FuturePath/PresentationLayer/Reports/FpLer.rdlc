                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Period: </Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#AFC0D8</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=First(Fields!PeriodText.Value, "ReportHeader")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>White</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>     </Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>White</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=First(Fields!ParametersText.Value, "ReportHeader")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>White</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>     Generated by: </Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#AFC0D8</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=First(Fields!GeneratedByName.Value, "ReportHeader")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>White</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>     Generated: </Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#AFC0D8</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=Format(First(Fields!GeneratedAt.Value, "ReportHeader"), "d MMM yyyy, HH:mm")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>White</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>     Exceptions listed: </Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>#AFC0D8</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=First(Fields!ExceptionCount.Value, "ReportHeader") &amp; " of " &amp; First(Fields!SessionsInScope.Value, "ReportHeader")</Value>
                        <Style>
                          <FontFamily>Segoe UI Semibold</FontFamily>
                          <FontSize>8pt</FontSize>
                          <Color>White</Color>
                        </Style>
