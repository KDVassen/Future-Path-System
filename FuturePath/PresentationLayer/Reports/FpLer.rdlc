            <TablixRowHierarchy>
              <TablixMembers>
                <!-- section title and column headings repeat on every page -->
                <TablixMember>
                  <KeepWithGroup>After</KeepWithGroup>
                  <RepeatOnNewPage>true</RepeatOnNewPage>
                </TablixMember>
                <TablixMember>
                  <KeepWithGroup>After</KeepWithGroup>
                  <RepeatOnNewPage>true</RepeatOnNewPage>
                </TablixMember>
                <!-- one block per faculty (reports.md Grouping); block order from the dataset -->
                <TablixMember>
                  <Group Name="FacultyGroup">
                    <GroupExpressions>
                      <GroupExpression>=Fields!FacultyID.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Fields!FacultySortOrder.Value</Value>
                    </SortExpression>
                    <SortExpression>
                      <Value>=Fields!FacultyName.Value</Value>
                    </SortExpression>
                  </SortExpressions>
                  <TablixMembers>
                    <TablixMember>
                      <KeepWithGroup>After</KeepWithGroup>
                      <RepeatOnNewPage>true</RepeatOnNewPage>
                    </TablixMember>
                    <!-- Not Currently Eligible (flag 1) before More Information Needed, then newest session first -->
                    <TablixMember>
                      <Group Name="ExceptionDetails" />
                      <SortExpressions>
                        <SortExpression>
                          <Value>=Fields!NotEligibleCount.Value</Value>
                          <Direction>Descending</Direction>
                        </SortExpression>
                        <SortExpression>
                          <Value>=Fields!SessionDate.Value</Value>
                          <Direction>Descending</Direction>
                        </SortExpression>
                        <SortExpression>
                          <Value>=Fields!SessionNumber.Value</Value>
                          <Direction>Descending</Direction>
                        </SortExpression>
                      </SortExpressions>
                    </TablixMember>
                  </TablixMembers>
                </TablixMember>
                <!-- report total row -->
                <TablixMember>
                  <KeepWithGroup>Before</KeepWithGroup>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
            <DataSetName>ExceptionListing</DataSetName>
