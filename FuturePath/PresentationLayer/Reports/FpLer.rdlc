<?xml version="1.0" encoding="utf-8"?>
<!--
  FP-LER  Learners Not Currently Eligible (spec 6.3, docs/design/reports.md).  Exception report, A4 landscape, 2 pages
  with the Part B sample data.  Data: typed DataSet ApplicationLayer\Reports\FpLerData.xsd, one RDLC DataSet per
  DataTable (same names).  No queries and no business rules here: every count, %, outcome, reason and alternative
  arrives from the Business Logic Layer.  The report only formats, sorts (faculty, outcome, newest first; charts by
  frequency), groups by faculty and totals with Count/Sum/CountRows.
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="FpLerData">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local Connection */</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>6d0f3c52-4a1e-4b8e-9b4c-2f1a7e5d9c01</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
