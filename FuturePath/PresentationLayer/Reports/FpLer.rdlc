          <Textbox Name="RestrictionLine">
            <CanGrow>false</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Restricted: </Value>
                    <Style>
                      <FontFamily>Segoe UI Semibold</FontFamily>
                      <FontSize>8.5pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>for Career Advisors and System Administrators only. Not for general circulation, and never given to a learner.</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8.5pt</FontSize>
                      <Color>#1B1F24</Color>
