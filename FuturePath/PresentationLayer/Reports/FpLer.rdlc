            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Sessions in scope: </Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8.5pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!SessionsInScope.Value, "ReportHeader")</Value>
                    <Style>
                      <FontFamily>Consolas</FontFamily>
                      <FontSize>8.5pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>      Exceptions: </Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8.5pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!ExceptionCount.Value, "ReportHeader") &amp; " (" &amp; Format(First(Fields!ExceptionPercent.Value, "ReportHeader"), "0.0") &amp; "%)"</Value>
                    <Style>
                      <FontFamily>Consolas</FontFamily>
                      <FontSize>8.5pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>      Not currently eligible: </Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8.5pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!NotEligibleCount.Value, "ReportHeader")</Value>
                    <Style>
                      <FontFamily>Consolas</FontFamily>
                      <FontSize>8.5pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>      More information needed: </Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8.5pt</FontSize>
                      <Color>#58606C</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!MoreInfoNeededCount.Value, "ReportHeader")</Value>
                    <Style>
                      <FontFamily>Consolas</FontFamily>
                      <FontSize>8.5pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>      Learners affected: </Value>
