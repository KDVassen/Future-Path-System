          <Textbox Name="AdvisoryDisclaimer">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Advisory disclaimer</Value>
                    <Style>
                      <FontFamily>Segoe UI Semibold</FontFamily>
                      <FontSize>8.5pt</FontSize>
                      <Color>#13294B</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Not Currently Eligible</Value>
                    <Style>
                      <FontFamily>Segoe UI Semibold</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> means the learner did not meet one or more of the stored requirements for the qualification selected, on the date of the session. It is not an admission decision, not a refusal and not a statement about any other qualification. </Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>More Information Needed</Value>
                    <Style>
                      <FontFamily>Segoe UI Semibold</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> only means the session was incomplete, so no eligibility check was finished. </Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>Grade 11 marks are projected and will change. </Value>
                    <Style>
                      <FontFamily>Segoe UI Semibold</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>Programme requirements are locally stored sample data; check them against the official university source before a learner relies on them. Future Path gives preliminary guidance only. This report contains learner and school data and is restricted to Career Advisors and System Administrators.</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Color>#1B1F24</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                  <LineHeight>12pt</LineHeight>
                </Style>
